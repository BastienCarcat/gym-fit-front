# GymFit API URL (server side only). Auth requests are proxied to it
GYM_FIT_BASE_URL=http://localhost:3000
# Same value as FRONTEND_PROXY_SECRET on the API: lets it trust the visitor's IP (rate limits)
FRONTEND_PROXY_SECRET=
# Key used by the demos of the landing page
GYM_FIT_API_KEY=

# Public URL of this site
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Cloudflare Turnstile on sign-up, sign-in and password reset; deploy it
# before TURNSTILE_SECRET_KEY on the API. Test key, always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog (EU region) project token, public. Without it nothing loads and no
# cookie banner is shown
NEXT_PUBLIC_POSTHOG_TOKEN=
