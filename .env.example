# GymFit API URL (server side only). Auth requests are proxied to it
GYM_FIT_BASE_URL=http://localhost:3000
# Same value as FRONTEND_PROXY_SECRET on the API: lets it trust the visitor's IP (rate limits)
FRONTEND_PROXY_SECRET=
# Key used by the demos of the landing page
GYM_FIT_API_KEY=
GYM_FIT_DOCUMENTATION_URL=

# Public URL of this site
NEXT_PUBLIC_SITE_URL=http://localhost:8080
